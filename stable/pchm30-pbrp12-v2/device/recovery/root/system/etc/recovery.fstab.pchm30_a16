# PCHM30 physical partitions; userdata currently ext4 + fscrypt v1 wrappedkey.
# /data/unencrypted/key is the fscrypt systemwide DE key location, NOT a
# metadata-encryption keydirectory. There is no dm-default-key data mapping.
/dev/block/bootdevice/by-name/system /system_root ext4 ro wait
/dev/block/bootdevice/by-name/vendor /vendor ext4 ro wait
/dev/block/bootdevice/by-name/odm /odm ext4 ro wait
/dev/block/bootdevice/by-name/metadata /metadata ext4 noatime,nosuid,nodev wait
/dev/block/bootdevice/by-name/userdata /data ext4 noatime,nosuid,nodev,barrier=1,noauto_da_alloc,discard,inlinecrypt,lazytime latemount,wait,check,fileencryption=ice,wrappedkey,quota
/dev/block/bootdevice/by-name/cache /cache ext4 noatime,nosuid,nodev wait
/dev/block/bootdevice/by-name/boot /boot emmc defaults defaults
/dev/block/bootdevice/by-name/recovery /recovery emmc defaults defaults
/dev/block/bootdevice/by-name/dtbo /dtbo emmc defaults defaults
/dev/block/bootdevice/by-name/vbmeta /vbmeta emmc defaults defaults
/dev/block/bootdevice/by-name/misc /misc emmc defaults defaults
/dev/block/bootdevice/by-name/modem /modem emmc defaults defaults
/dev/block/bootdevice/by-name/dsp /dsp emmc defaults defaults
/dev/block/bootdevice/by-name/persist /persist ext4 noatime,nosuid,nodev wait
